{
  "name": "atflows",
  "version": "0.1.0-beta.4",
  "description": "See what your LLM calls cost. One command. No signup.",
  "private": false,
  "type": "module",
  "bin": {
    "atflows": "./bin/atflows.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e/*"
  ],
  "scripts": {
    "start": "bun run --filter @atflows/server start",
    "start:verbose": "VERBOSE=1 bun run --filter @atflows/server start",
    "dev": "bun run --filter @atflows/server dev",
    "dev:server": "bun run --filter @atflows/server dev",
    "dev:dashboard": "bun run --filter @atflows/dashboard dev",
    "build": "bun run --filter @atflows/dashboard build",
    "demo": "bun run --filter @atflows/server demo",
    "demo:many": "bun run --filter @atflows/server demo:many",
    "test": "bun run --filter @atflows/server test",
    "test:otlp": "bun run --filter @atflows/server test:otlp",
    "test:ws": "bun run --filter @atflows/server test:ws",
    "test:logs": "bun run --filter @atflows/server test:logs",
    "test:metrics": "bun run --filter @atflows/server test:metrics",
    "test:providers": "bun run --filter @atflows/server test:providers",
    "test:providers-e2e": "bun run --filter @atflows/server test:providers-e2e",
    "test:e2e": "bunx playwright test",
    "test:e2e:headed": "bunx playwright test --headed",
    "test:e2e:ui": "bunx playwright test --ui",
    "typecheck": "bun run --filter '*' typecheck",
    "prepublishOnly": "bun install && bun run build"
  },
  "files": [
    "bin/",
    "apps/server/src/",
    "packages/*/src/",
    "packages/*/package.json",
    "packages/pricing/pricing.fallback.json",
    "public/",
    "docs/integrations/",
    "LICENSE",
    "LICENSE-MIT-LLMFLOW",
    "NOTICE"
  ],
  "keywords": [
    "llm",
    "observability",
    "tracing",
    "openai",
    "anthropic",
    "langchain",
    "opentelemetry",
    "cost-tracking",
    "ai",
    "bun"
  ],
  "author": "Javad Taghia",
  "license": "Apache-2.0 AND MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aetna000/atflows"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "typescript": "^6.0.3"
  }
}
